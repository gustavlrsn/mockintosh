{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "WebWorker"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "target": "es2020",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "@/*": ["./*"],
      "@mockintosh/quickdraw": ["./packages/quickdraw/src/index.ts"],
      "@mockintosh/quickdraw/bits": ["./packages/quickdraw/src/bits.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/protocol/src/**/*.ts",
    "packages/agent/src/**/*.ts",
    "packages/sdk/src/**/*.ts",
    "packages/sdk/src/**/*.tsx",
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx",
    "packages/fs/src/**/*.ts",
    "packages/print/src/**/*.ts",
    "utils/**/*.ts",
    "vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "api", "scripts", "packages/quickdraw"]
}
